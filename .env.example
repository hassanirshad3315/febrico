# ──────────────────────────────────────────────────
# FABRICO — Supabase Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
#
# 1. Go to https://supabase.com → create/open your project.
# 2. Navigate to Project Settings → API.
# 3. Copy the values below.
# ──────────────────────────────────────────────────

# Your Supabase project reference ID (the subdomain part of your URL)
SUPABASE_PROJECT_ID=""

# Public/anon key — safe to expose in the browser
SUPABASE_PUBLISHABLE_KEY=""

# Full project URL
SUPABASE_URL=""

# Service role key — server-side only, NEVER expose to the client
# Required for admin operations that bypass Row Level Security (RLS)
SUPABASE_SERVICE_ROLE_KEY=""

# ── Vite client-side duplicates (prefixed with VITE_ for browser access) ──
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
